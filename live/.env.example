NODE_ENV=production
HOST=0.0.0.0
PORT=4177
ADMIN_USERNAME=admin
ADMIN_NAME=管理员
# Set a unique password of at least 12 characters before startup.
ADMIN_PASSWORD=
# Independent password for read-only dashboard access.
DASHBOARD_PASSWORD=
# Existing room and seller booking application.
BOOKING_URL=http://127.0.0.1:3000/
# Enable after an HTTPS reverse proxy is configured. Cookies require HTTPS.
COOKIE_SECURE=true
# Native server only: use a fresh directory for production, never the demo database.
DATA_DIR=./data-production

# Optional. Configure a company OpenAI-compatible chat API on the backend.
# Keep these blank to disable live AI requests.
ASSISTANT_API_URL=
ASSISTANT_API_KEY=
ASSISTANT_MODEL=
ASSISTANT_FALLBACK_API_URL=
ASSISTANT_FALLBACK_API_KEY=
ASSISTANT_FALLBACK_MODEL=
# Defaults. A reverse proxy may share one address bucket across visitors.
ASSISTANT_TIMEOUT_MS=8000
ASSISTANT_IDENTITY_DAILY_REQUESTS=15
ASSISTANT_ADDRESS_DAILY_REQUESTS=60
ASSISTANT_GLOBAL_DAILY_REQUESTS=200
ASSISTANT_GLOBAL_DAILY_UNITS=800000
