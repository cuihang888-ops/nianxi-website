{
  "name": "anheli-courtyard",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev:all": "node scripts/dev.mjs",
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "live": "node service/server.mjs",
    "test:live": "node --test service/*.test.mjs",
    "test:farm": "node --test tests/farm-state.test.mjs tests/farm-scene.test.mjs tests/world-state.test.mjs",
    "test:ui": "playwright test",
    "test": "node --test tests/farm-state.test.mjs tests/farm-scene.test.mjs tests/world-state.test.mjs service/*.test.mjs",
    "verify:calendar": "node scripts/verify-calendar.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.577.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "0.187.0",
    "ws": "^8.19.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "vite": "^7.3.1"
  }
}
